import java.io.*;
import java.util.*;

public class Solution {
    static int[] manacher(int[] a) {
        int n = a.length;
        int[] radius = new int[n];
        int right = 0;
        int center = 0;
        for (int i = 0; i < n; i++) {
            if (i < right) {
                radius[i] = Math.min(
                        radius[2 * center - i],
                        right - i
                );
            } else {
                radius[i] = 1;
            }
            while (i - radius[i] >= 0 &&
                   i + radius[i] < n &&
                   a[i - radius[i]] == a[i + radius[i]]) {
                radius[i]++;
            }
            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }
        for (int i = 0; i < n; i++) {
            radius[i]--;
        }
        return radius;
    }
    static class SparseTable {
        int[][] table;
        int[] log;
        SparseTable(int[] arr) {
            int n = arr.length;
            log = new int[n + 1];
            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }
            int levels = log[n] + 1;
            table = new int[levels][];
            table[0] = arr.clone();
            for (int j = 1; j < levels; j++) {
                int size = n - (1 << j) + 1;
                table[j] = new int[Math.max(size, 0)];
                int half = 1 << (j - 1);
                for (int i = 0; i < size; i++) {
                    table[j][i] = Math.max(
                            table[j - 1][i],
                            table[j - 1][i + half]
                    );
                }
            }
        }
        int query(int left, int right) {
            if (left > right) {
                return 0;
            }
            int length = right - left + 1;
            int k = log[length];
            return Math.max(
                    table[k][left],
                    table[k][right - (1 << k) + 1]
            );
        }
    }
    public static void main(String[] args) throws Exception {
        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();
        String doubled = s + s;
        int m = 4 * n + 1;
        int[] transformed = new int[m];
        for (int i = 0; i < 2 * n; i++) {
            transformed[2 * i] = 26; 
            transformed[2 * i + 1] =
                    doubled.charAt(i) - 'a';
        }
        transformed[m - 1] = 26;
        int[] radius = manacher(transformed);
        SparseTable st = new SparseTable(radius);
        StringBuilder output = new StringBuilder();
        for (int start = 0; start < n; start++) {
            int left = start * 2 + 1;
            int right = (start + n - 1) * 2 + 1;
            int low = 1;
            int high = n;
            int answer = 1;
            while (low <= high) {
                int len = (low + high) / 2;
                int centerLeft = left + len - 1;
                int centerRight = right - len + 1;
                if (centerLeft <= centerRight) {
                    int maxRadius =
                            st.query(centerLeft, centerRight);
                    if (maxRadius >= len) {
                        answer = len;
                        low = len + 1;
                    } else {
                        high = len - 1;
                    }

                } else {
                    high = len - 1;
                }
            }
            output.append(answer).append('\n');
        }
        System.out.print(output);
    }
}


